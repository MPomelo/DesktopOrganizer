<Window x:Class="DesktopOrganizer.App.Views.ReleaseConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭并释放图标"
        Width="560" Height="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="关闭并释放图标确认"
        FontFamily="Microsoft YaHei UI"
        Background="#FFF4F5F7"
        Foreground="#FF20242A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,18" Background="White" BorderBrush="#FFD9DDE3" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="关闭收纳区并释放图标" />
                <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="#FF59616C"
                           Text="确认后将删除当前收纳区，原文件和文件夹不会被移动。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22,18">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#FF616A75" Text="图标总数" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding TotalCount}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="#FF616A75" Text="无需重复创建" />
                    <TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding NoActionCount}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="释放到桌面" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding DesktopCount}" />
            </Grid>
            <Slider Minimum="0" Maximum="{Binding MaximumDesktopCount}" Value="{Binding DesktopCount}"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    AutomationProperties.Name="释放到桌面的数量" />
            <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="#FF66707C"
                       Text="{Binding CapacityExplanation}" TextWrapping="Wrap" />

            <Grid Margin="0,20,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="添加到开始菜单" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding StartMenuCount}" />
            </Grid>
            <TextBlock FontSize="11" Foreground="#FF66707C" Text="{Binding StartMenuDirectory}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Padding="22,13" Background="White" BorderBrush="#FFD9DDE3" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Width="92" Height="34" Margin="0,0,10,0"
                        AutomationProperties.Name="取消关闭" IsCancel="True" IsDefault="True"
                        Click="OnCancelClick" Content="取消" />
                <Button Width="108" Height="34" AutomationProperties.Name="确认关闭"
                        Click="OnConfirmClick" Content="确认关闭" Foreground="#FF9F2424" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
